{
  "name": "legends-runes",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "Independent single-player match-3 RPG, using the owner's Warband Legends roster.",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node tools/build.mjs",
    "check": "npm test && npm run build",
    "test:browser": "node tests/browser.mjs",
    "test:shell": "node tests/shell-browser.mjs",
    "test:visuals": "node tests/visuals-browser.mjs",
    "test:experience": "node tests/experience-browser.mjs",
    "test:development": "node tests/development-browser.mjs",
    "test:adventure": "node tests/adventure-browser.mjs",
    "test:modes": "node tests/modes-browser.mjs",
    "roster:build": "node tools/rebalance-roster.mjs",
    "art:build": "node tools/make-runes.mjs",
    "test:tactics": "node tests/tactics-browser.mjs",
    "test:economy": "node tests/economy-browser.mjs",
    "test:viewport": "node tests/viewport-browser.mjs",
    "test:ascension": "node tests/ascension-browser.mjs",
    "test:covenant": "node tests/covenant-browser.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
